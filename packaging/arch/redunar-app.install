post_install() {
  if [[ -x /usr/bin/udevadm ]]; then
    /usr/bin/udevadm control --reload-rules >/dev/null 2>&1 || true
    /usr/bin/udevadm trigger --subsystem-match=input --sysname-match='event*' --property-match=ID_INPUT_KEYBOARD=1 --action=change >/dev/null 2>&1 || true
  fi
}

post_upgrade() {
  post_install
}
